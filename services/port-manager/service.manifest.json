{
  "schemaVersion": 1,
  "moduleId": "port-manager",
  "name": "\u7aef\u53e3\u7ba1\u7406\u670d\u52a1",
  "version": "1.0.0",
  "type": "resource-service",
  "riskLevel": "low",
  "businessWritesEnabled": false,
  "writesServiceState": true,
  "prohibitedDirectAccess": ["PortManager internal modules", "PortManager SQLite", "browser Profile", "credentials and browser storage"],
  "resourceSelectionContract": {
    "modes": ["single", "multi", "all"],
    "resourceExecutionPolicy": {"single": "same-resource-exclusive", "multi": "policy-pending", "all": "cross-resource-parallel"},
    "userSelection": "User selects a visible list index; the adapter binds the internal resource fact. User-facing paths must not ask for ResourceId.",
    "confirmationPolicy": "BSClaw-Local owns user-facing confirmation for service-state-write actions. Public JSON calls receive internally bound resourceId and a non-user-facing confirmation token when required.",
    "singleActions": ["resource-detail", "check-resource", "storage-plan", "register", "edit", "enable", "disable", "delete", "occupancy", "login-check", "cancel-login-check", "open-resource", "login-resource"],
    "allActions": ["check-all"],
    "multiActions": [],
    "multiNote": "Multi-resource execution requires an explicit policy before use."
  },
  "entry": {"runtime": "python", "path": "port_manager_service_adapter.py"},
  "externalService": {"environmentVariable": "BSCLAW_PORT_MANAGER_ROOT", "siblingDirectory": "PortManager-Phase1", "publicEntry": "port-manager.ps1", "outputFormat": "single-json-document"},
  "actions": [
    {"id": "service-check", "mode": "read-only", "writeLevel": "pure-read", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90, "resultCheck": {"mode": "result-contract", "requiredFields": ["serviceId", "entryAvailable", "jsonContract", "resourceCount", "sqliteIntegrity", "schemaVersion", "checkedAt", "readOnly"]}},
    {"id": "list-resources", "mode": "read-only", "writeLevel": "pure-read", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90, "resultCheck": {"mode": "plugin", "action": "list-resources"}},
    {"id": "resource-detail", "mode": "read-only", "writeLevel": "pure-read", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90, "resultCheck": {"mode": "plugin", "action": "resource-detail"}},
    {"id": "check-resource", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90, "resultCheck": {"mode": "result-contract", "requiredFields": ["resource", "connectionStatus", "pageStatus", "loginStatus", "apiStatus", "confidence", "checkedAt", "nextAction"]}},
    {"id": "storage-plan", "mode": "read-only", "writeLevel": "pure-read", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 180, "resultCheck": {"mode": "result-contract", "requiredFields": ["executeMode", "readOnly", "totals"]}},
    {"id": "register", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "edit", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "enable", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "disable", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "delete", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "check-all", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "resourceSelectionMode": "all", "resourceExecutionPolicy": "cross-resource-parallel", "concurrencyPolicy": "per-resource", "timeoutSeconds": 180},
    {"id": "occupancy", "mode": "read-only", "writeLevel": "pure-read", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "login-check", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "cancel-login-check", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "open-resource", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 90},
    {"id": "login-resource", "mode": "service-state-write", "writeLevel": "service-state-write", "requiresHuiceResource": false, "resourcePolicy": "none", "timeoutSeconds": 180}
  ],
  "userInterface": {"section": "local-services", "summary": "\u7ba1\u7406\u672c\u673a\u7aef\u53e3\u8d44\u6e90\u3001\u767b\u5f55\u72b6\u6001\u548c\u6d4f\u89c8\u5668\u73af\u5883\u3002"},
