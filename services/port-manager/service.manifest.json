    {"id": "resource-detail", "action": "resource-detail", "displayName": "\u67e5\u770b\u8d44\u6e90\u8be6\u60c5", "category": "\u67e5\u770b", "writeLevel": "pure-read", "requiresResourceSelection": true, "requiresLoginGate": false, "requiresConfirmation": false, "progressText": "\u6b63\u5728\u8bfb\u53d6\u8d44\u6e90\u8be6\u60c5", "successResultView": "resource-detail", "failureNextAction": "\u8fd4\u56de\u8d44\u6e90\u5217\u8868\u5e76\u91cd\u8bd5", "retryable": true, "cancellable": true, "recoverable": true, "dispatch": "scheduler"},
    {"id": "check-resource", "action": "check-resource", "displayName": "\u91cd\u65b0\u68c0\u67e5\u72b6\u6001", "category": "\u68c0\u67e5", "writeLevel": "service-state-write", "requiresResourceSelection": true, "requiresLoginGate": false, "requiresConfirmation": false, "progressText": "\u6b63\u5728\u68c0\u67e5\u8fde\u63a5\u3001\u9875\u9762\u548c\u767b\u5f55\u72b6\u6001", "successResultView": "resource-detail", "failureNextAction": "\u6309\u63d0\u793a\u5b8c\u6210\u767b\u5f55\u6216\u4fee\u590d\u8fde\u63a5\u540e\u91cd\u8bd5", "retryable": true, "cancellable": true, "recoverable": true, "dispatch": "scheduler"},
