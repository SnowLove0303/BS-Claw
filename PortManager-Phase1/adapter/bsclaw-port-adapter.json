{
  "schemaVersion": 2,
  "moduleId": "bsclaw.port-manager.huice.phase1",
  "name": "Huice Port Manager Phase 1",
  "version": "0.4.0",
  "status": "phase1-local-integration-under-audit",
  "entryScript": "port-manager.ps1",
  "runtime": {"type": "powershell", "minimumVersion": "5.1", "platform": "windows", "workingDirectory": ".", "rootDirectory": ".", "dataDirectory": "./data", "logsDirectory": "./logs", "browserProfilesDirectory": "${BSCLAW_PROFILE_ROOT:-../_portmanager-profiles}", "overrideEnvironmentVariable": "BSCLAW_PM_RUNTIME_ROOT"},
  "huiceAdapter": {
    "platformId": "huice",
    "displayName": "Huice",
    "defaultStartUrl": "https://login.huice.com/",
    "platformUrlPatterns": ["*://huice.com/*", "*://*.huice.com/*", "*://wangdian.cn/*", "*://*.wangdian.cn/*"],
    "loginPagePatterns": ["*://login.huice.com/*", "*://*.huice.com/*login*", "*://*.wangdian.cn/*login*"],
    "loginEvidencePolicy": "Only live same-origin CDP auth continuation plus a read-only API probe can produce logged-in-api-ready.",
    "browserPolicy": "Use verified Google Chrome only; no alternate browser fallback.",
    "loginDetection": {
      "states": ["not-detected", "not-logged-in", "logged-in", "unknown", "check-failed", "session-expired"],
      "loginPagePatterns": ["*://login.huice.com/*", "*://*.huice.com/*login*", "*://*.wangdian.cn/*login*"],
      "authenticatedEvidenceRules": [{"id": "huice-live-cdp-storage-and-api-v1", "enabled": true, "requiredStorageKeys": ["v-token", "vToken", "X-HC-TOKEN", "shopId"], "allowedCookieNames": ["X-HC-TOKEN", "v-token", "vToken"], "allowedDomains": [".huice.com", ".huiscm.cn"], "requiresTargetBusinessPage": true, "requiresReadOnlyApiProbe": true}],
      "authenticatedEvidenceAvailable": true,
      "authenticatedEvidenceSource": "HuiceLoginAgent live CDP auth refresh and read-only API probe",
      "unknownPolicy": "Keep login state unknown without real authentication evidence.",
      "evidenceVersion": "1"
    }
  },
  "interactiveRegistration": {
    "normalChoices": ["use-running-huice-chrome", "auto-launch-google-chrome"],
    "defaultChoice": "use-running-huice-chrome when a verified Huice CDP page exists; otherwise auto-launch-google-chrome",
    "automaticFields": ["hostName", "port", "connectionMode", "browserExecutable", "browserProfileDirectory", "startUrl", "platformUrlPatterns", "loginPagePatterns", "enabled"],
    "optionalFirstRunFields": ["resourceName"],
    "advancedOnlyFields": ["hostName", "port", "connectionMode", "browserExecutable", "browserProfileDirectory", "startUrl", "platformUrlPatterns", "loginPagePatterns", "notes"],
    "postRegistrationActions": ["open", "check", "return-to-menu"]
  },
  "supportedOperations": [
    {"name": "ServiceCheck", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "StoragePlan", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "List", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "Detail", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "Register", "riskLevel": "medium", "requiresHumanConfirmation": true, "confirmationOwner": "BSClaw-Local user entry or PortManager text menu"},
    {"name": "Edit", "riskLevel": "medium", "requiresHumanConfirmation": true, "confirmationOwner": "BSClaw-Local user entry or PortManager text menu"},
    {"name": "Enable", "riskLevel": "medium", "requiresHumanConfirmation": true, "confirmationOwner": "BSClaw-Local user entry or PortManager text menu"},
    {"name": "Disable", "riskLevel": "medium", "requiresHumanConfirmation": true, "confirmationOwner": "BSClaw-Local user entry or PortManager text menu"},
    {"name": "Check", "riskLevel": "low", "requiresHumanConfirmation": false},
    {"name": "CheckAll", "riskLevel": "low", "requiresHumanConfirmation": false},
    {"name": "Open", "riskLevel": "medium", "requiresHumanConfirmation": true, "confirmationOwner": "BSClaw-Local user entry or PortManager text menu", "sideEffects": ["may start a configured browser process", "may create a new browser tab", "may create browser profile files under the configured F drive directory"]},
    {"name": "Delete", "riskLevel": "high", "requiresHumanConfirmation": true, "confirmationOwner": "BSClaw-Local user entry or PortManager text menu", "confirmationFormat": "selected-resource-confirmation", "jsonConfirmationToken": "confirm-delete-selected-resource", "userInputPolicy": "User selects a visible resource and confirms the deletion; user-facing paths must not ask for ResourceId."},
    {"name": "Occupancy", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "LoginCheck", "riskLevel": "low", "requiresHumanConfirmation": false},
    {"name": "HuiceCheck", "riskLevel": "low", "requiresHumanConfirmation": false},
    {"name": "HuiceLogin", "riskLevel": "medium", "requiresHumanConfirmation": true, "confirmationOwner": "formal login/intervention entry", "interactiveWhenLoginRequired": true},
    {"name": "CachePlan", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "DeploymentCleanPlan", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true},
    {"name": "StorageAudit", "riskLevel": "low", "requiresHumanConfirmation": false, "readOnly": true}
  ],
  "inputs": {"resourceId": {"type": "string", "format": "HCP-XXXXXXXX", "requiredFor": ["Detail", "Edit", "Enable", "Disable", "Check", "Open", "Delete"]}, "register": {"resourceName": "string", "platformName": "string", "hostName": "localhost-or-explicit-private-ip", "port": "integer:1..65535", "connectionMode": "ConnectOnly|Launch", "browserExecutable": "absolute-existing-file", "browserProfileDirectory": "absolute-F-drive-directory", "startUrl": "optional-http-or-https-url", "platformUrlPatterns": "optional-comma-separated-wildcards", "loginPagePatterns": "optional-comma-separated-wildcards", "disabled": "boolean", "notes": "optional-string"}},
  "output": {"defaultLanguage": "zh-CN", "humanFormat": "Text", "adapterFormat": "Json", "jsonEnvelope": {"success": "boolean", "message": "localized result or failure message", "data": "operation-specific object", "nextAction": "one next action or null", "stdoutPolicy": "exactly one JSON document in Json mode; prompts and tables are forbidden", "failureExitCode": "non-zero"}, "statusValues": {"connection": ["unavailable", "port-listening", "browser-connected", "port-conflict", "check-failed"], "page": ["platform-page-correct", "platform-page-error", "page-not-found", "page-state-unknown"], "login": ["not-detected", "logged-in", "not-logged-in", "unknown", "check-failed", "session-expired"], "operation": ["registered", "edited", "check-completed", "check-failed", "open-succeeded", "open-failed"]}, "occupancyFields": ["currentOccupancy", "currentOccupancyDetails", "ownerProcessIds", "activeLeases"]},
  "resourceDataModel": {"schemaVersion": 2, "fields": ["platformId", "credentialRef", "maskedAccountSummary", "loginAutomationState", "sessionPolicy", "lastStatus.loginStatus", "lastStatus.loginEvidence", "lastStatus.loginCheckedAt", "lastStatus.currentOccupancyDetails"], "credentialPolicy": "credentialRef only; passwords, cookies, tokens and complete authorization headers are forbidden", "autoLoginImplemented": true, "currentStateAuthority": "port_runtime_states", "loginAdapter": "HuiceLoginAgent"},
  "platformDependencies": ["Windows", "PowerShell 5.1 or later", "real TCP port", "Google Chrome remote debugging endpoint for interactive browser discovery and launch"],
  "portDependency": {"selection": "resourceId", "hardCodedPortForbidden": true, "remoteDebuggingProtocol": "Chrome DevTools Protocol HTTP endpoints", "registrationHostPolicy": "localhost, loopback, RFC1918, link-local, or IPv6 ULA explicit IP only", "remoteReadOnlyChecks": true, "remoteCdpControl": false, "openHostPolicy": "loopback-only"},
  "errorHandling": {"nonZeroExitOnFailure": true, "auditedActions": ["Register", "Edit", "Check", "Open", "Delete"], "secretsRedacted": true, "rejectEditOrDeleteWhileInUse": true, "recheckUsageInsideWriteLock": true, "persistLatestFailureStatus": true, "cleanupOwnedBrowserOnOpenFailure": true},
  "bsclawCompatibility": {"target": "future BSClaw plugin loader", "minimumVersion": "0.1.0", "currentIntegration": true, "integrationMode": "external-service-adapter", "integrationRequirement": "BSClaw must invoke only the public port-manager.ps1 JSON contract; direct PSM1 or SQLite access is forbidden."}
}
